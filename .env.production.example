APP_NAME="Reyno Andrean Wijaksono"
APP_ENV=production
APP_KEY=base64:br7+pCjfNZ5JO0rcuaTImvpxFT4X5U7WQmaXLn0fQJo=
APP_DEBUG=false
APP_URL=https://DOMAIN-SAYA.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database MySQL Production (Sesuaikan dengan data dari hosting/TiDB Cloud)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=NAMA_DATABASE_PRODUCTION
DB_USERNAME=USER_DATABASE_PRODUCTION
DB_PASSWORD=PASSWORD_DATABASE_PRODUCTION
MYSQL_ATTR_SSL_CA=

# Session, Cache & Security
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@DOMAIN-SAYA.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
